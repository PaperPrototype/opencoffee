PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# From `pnpm db:status` (PUBLISHABLE_KEY). Safe to expose to the browser.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. From `pnpm db:status` (SECRET_KEY). Never expose this.
SUPABASE_SECRET_KEY=

# Stripe (platform account with Connect enabled): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:5180/api/stripe/webhook` prints this (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Only if you add a separate Connect webhook endpoint in the dashboard.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Outgoing mail (ticket confirmations, refunds, cancellations). Any SMTP provider works
# (Resend, Postmark, SES…). Local: Mailpit from `pnpm db:start`, viewable at http://127.0.0.1:55324.
SMTP_URL=smtp://127.0.0.1:55325
EMAIL_FROM=Specialty Coffee Community <events@specialtycoffeecommunity.com>
